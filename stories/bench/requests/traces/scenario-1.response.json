    {
      "text": "{\"why\":\"The README's very first example is `requests.get(url, auth=('user','pass'))` followed by inspecting `status_code`, `headers['content-type']`, `encoding`, `text` and `json()`. This script follows exactly that journey, but against the repository's own in-repo loopback test server (`tests/testserver/server.py`, the same helper `tests/test_lowlevel.py` uses) so no external network is required.\",\"script\":\"\\\"\\\"\\\"The README's first example, served by the repository's own test server.\\n\\nA single GET with HTTP Basic Auth travels from requests.get() through the\\nSession, PreparedRequest, HTTPAdapter and back out as a Response whose JSON\\nbody we decode.\\n\\\"\\\"\\\"\\n\\nimport json\\n\\nimport requests\\nfrom tests.testserver.server import Server\\n\\n# The canned response our local server will send back, mirroring what\\n# https://httpbin.org/basic-auth/user/pass returns in the README.\\nbody = json.dumps({\\\"authenticated\\\": True, \\\"user\\\": \\\"user\\\"})\\nraw_response = (\\n    \\\"HTTP/1.1 200 OK\\\\r\\\\n\\\"\\n    \\\"Content-Type: application/json; charset=utf-8\\\\r\\\\n\\\"\\n    f\\\"Content-Length: {len(body)}\\\\r\\\\n\\\"\\n    \\\"Connection: close\\\\r\\\\n\\\"\\n    \\\"\\\\r\\\\n\\\" + body\\n)\\n\\nserver = Server.text_response_server(raw_response)\\n\\nwith server as (host, port):\\n    url = f\\\"http://{host}:{port}/basic-auth/user/pass\\\"\\n    r = requests.get(url, auth=(\\\"user\\\", \\\"pass\\\"))\\n\\nprint(r.status_code)\\nprint(r.headers[\\\"content-type\\\"])\\nprint(r.encoding)\\nprint(r.text)\\nprint(r.json())\\n\\n# The credentials were turned into a Basic auth header on the way out...\\nsent = server.handler_results[0].decode(\\\"utf-8\\\")\\nassert \\\"Authorization: Basic dXNlcjpwYXNz\\\" in sent\\n\\n# ...and the response came back decoded exactly as the README promises.\\nassert r.status_code == 200\\nassert r.headers[\\\"content-type\\\"] == \\\"application/json; charset=utf-8\\\"\\nassert r.encoding == \\\"utf-8\\\"\\nassert r.json() == {\\\"authenticated\\\": True, \\\"user\\\": \\\"user\\\"}\\n\"}",
      "type": "text"
    }
