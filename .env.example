# Copy to .env and fill in. .env is never committed.
#
# Simplest path: put an Anthropic API key in ANTHROPIC_API_KEY and leave everything else empty. That is all a story
# needs. Every other setting below is optional.

# Which model writes the stories (codestory/llm.py). Leave empty to use the Anthropic API when ANTHROPIC_API_KEY is
# set, otherwise your Claude login through the Claude Code CLI. The choices:
#   anthropic   the Anthropic API; needs ANTHROPIC_API_KEY (the default when the key is set)
#   claude-cli  your Claude subscription, through the Claude Code CLI (`claude`, signed in; the default otherwise)
#   codex-cli   your ChatGPT login, through the Codex CLI (`codex login`; CODEX_BIN if it isn't on the PATH)
#   foundry     a deployment on Azure AI Foundry: FOUNDRY_ENDPOINT, and FOUNDRY_API_KEY or an `az login`
CODESTORY_PROVIDER=
# The model, or for foundry the deployment name (required there). Empty means the provider's default
# (claude-opus-5 for anthropic, the CLI's own choice for claude-cli and codex-cli).
CODESTORY_MODEL=

# Required for the anthropic provider; not needed for the others.
ANTHROPIC_API_KEY=

# Optional: Azure AI Foundry. https://<resource>.services.ai.azure.com serves both OpenAI deployments (through the
# Responses API) and Claude deployments (claude-*). Leave the key empty to use your `az login`.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=

# Optional: the contradiction judge (Jev, on Cloudflare). Without these the report says the judge was skipped.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
