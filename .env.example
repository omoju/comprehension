# Copy to .env and fill in. .env is never committed.

# Which model writes the stories (codestory/llm.py). One of:
#   anthropic   needs ANTHROPIC_API_KEY (the default when it is set)
#   claude-cli  your Claude login, through the Claude Code CLI (`claude`; the default otherwise)
#   codex-cli   your ChatGPT login, through the Codex CLI (`codex login`; CODEX_BIN if it isn't on the PATH)
#   foundry     an Azure AI Foundry deployment: FOUNDRY_ENDPOINT, and FOUNDRY_API_KEY or an `az login`
CODESTORY_PROVIDER=
# The model, or for foundry the deployment name (required there); empty means the provider's default
# (claude-opus-5 for anthropic, the CLI's own choice for claude-cli and codex-cli).
CODESTORY_MODEL=

ANTHROPIC_API_KEY=

# Azure AI Foundry: https://<resource>.services.ai.azure.com serves both OpenAI deployments (through the Responses
# API) and Claude deployments (claude-*). Leave the key empty to use your `az login`.
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=

# The contradiction judge (Jev, on Cloudflare); optional.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
